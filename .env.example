# ---- Supabase (required) ----------------------------------------------------
# Never commit real keys. The anon/publishable key is safe for the browser;
# NEVER put a service-role / secret key in any VITE_ variable or frontend code.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# ---- Map provider (optional — defaults shown) ------------------------------
# Any MapLibre style URL (tiles + style together). Default: OpenFreeMap.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Fallback map centre used until the admin saves the campus centre in
# Admin → Manage campus locations → Campus settings (format: lat,lng).
# Leave unset until the real campus coordinates are known.
#VITE_MAP_CENTER=8.4799,4.5226
#VITE_MAP_ZOOM=14

# ---- Routing provider (optional — defaults shown) --------------------------
# Routing SERVER ORIGIN; the standard OSRM route path is appended automatically.
# Public demo server by default — rate-limited, fine for development/testing,
# NOT a production SLA.
VITE_ROUTING_URL=https://router.project-osrm.org

# ---- Live tracking tuning (optional — defaults shown) ----------------------
# Drop GPS fixes less accurate than this many metres.
#VITE_TRACK_MAX_ACCURACY_M=100
# "Nearby" arrival hint radius in metres (display only — ride states never
# change from GPS; they still move through the server-side functions).
#VITE_ARRIVAL_RADIUS_M=40
